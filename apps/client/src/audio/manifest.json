      "file": "ui-f78676d157.mp3"
    },
    {
      "id": "ui-40ffc43d8c",
      "voice": "ui",
      "text": "Pode pegar.",
      "file": "ui-40ffc43d8c.mp3"
    },
    {
      "id": "ui-e053664a2e",
      "voice": "ui",
      "text": "Volte sempre.",
      "file": "ui-e053664a2e.mp3"
    },
    {
      "id": "ui-31a9d79ea0",
      "voice": "ui",
      "text": "Isso aí.",
      "file": "ui-31a9d79ea0.mp3"
    },
    {
      "id": "ui-2687598818",
      "voice": "ui",
      "text": "pão de queijo",
      "file": "ui-2687598818.mp3"
    },
    {
      "id": "ui-f5a502d222",
      "voice": "ui",
      "text": "misto-quente",
      "file": "ui-f5a502d222.mp3"
    },
    {
      "id": "ui-3d62135dc8",
      "voice": "ui",
      "text": "guaraná",
      "file": "ui-3d62135dc8.mp3"
    },
    {
      "id": "ui-3776da2797",
      "voice": "ui",
      "text": "Pois não.",
      "file": "ui-3776da2797.mp3"
    },
    {
      "id": "ui-e3044e1be6",
      "voice": "ui",
      "text": "Tá na mão.",
      "file": "ui-e3044e1be6.mp3"
    },
    {
      "id": "ui-f3e10e138a",
      "voice": "ui",
      "text": "por conta da casa",
      "file": "ui-f3e10e138a.mp3"
    },
    {
      "id": "ui-8f97792d48",
      "voice": "ui",
      "text": "Bom dia",
      "file": "ui-8f97792d48.mp3"
    },
    {
      "id": "ui-6278b6448c",
      "voice": "ui",
      "text": "Boa tarde",
      "file": "ui-6278b6448c.mp3"
    },
    {
      "id": "ui-06124de222",
      "voice": "ui",
      "text": "Boa noite",
      "file": "ui-06124de222.mp3"
    },
    {
      "id": "ui-528e385040",
      "voice": "ui",
      "text": "Olá",
      "file": "ui-528e385040.mp3"
    },
    {
      "id": "ui-3c89984cef",
      "voice": "ui",
      "text": "Oi",
      "file": "ui-3c89984cef.mp3"
    },
    {
      "id": "ui-03e5de8e41",
      "voice": "ui",
      "text": "Tudo bem?",
      "file": "ui-03e5de8e41.mp3"
    },
    {
      "id": "ui-fba9f79414",
      "voice": "ui",
      "text": "Beleza",
      "file": "ui-fba9f79414.mp3"
    },
    {
      "id": "ui-04781fbbf2",
      "voice": "ui",
      "text": "Obrigado / Obrigada",
      "file": "ui-04781fbbf2.mp3"
    },
    {
      "id": "ui-329997c41f",
      "voice": "ui",
      "text": "De nada",
      "file": "ui-329997c41f.mp3"
    },
    {
      "id": "ui-a122883786",
      "voice": "ui",
      "text": "Tchau",
      "file": "ui-a122883786.mp3"
    },
    {
      "id": "ui-162065ffc2",
      "voice": "ui",
      "text": "um / uma",
      "file": "ui-162065ffc2.mp3"
    },
    {
