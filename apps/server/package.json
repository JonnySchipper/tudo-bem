{
  "name": "@tudobem/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:bufferutil --external:utf-8-validate --external:onnxruntime-node --external:better-sqlite3 --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "better-sqlite3": "^13.0.3",
    "jose": "^6.2.12",
    "onnxruntime-node": "1.30.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tudobem/shared": "workspace:*",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./world": "./src/world.ts",
    "./store": "./src/store.ts",
    "./academy": "./src/academyStore.ts",
    "./padaria": "./src/padariaStore.ts",
    "./services": "./src/services/stubs.ts"
  }
}
