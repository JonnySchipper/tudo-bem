{
  "version": "0.1",
  "gdd_ref": "§12.4 public chat",
  "description": "Stub Jev typed questions + labeled EN/PT examples for public chat. Prefer allow; slang allow cases are intentional gold.",
  "typed_questions": [
    {
      "id": "content_class",
      "type": "choice",
      "choices": [
        "ok",
        "insult",
        "sexual",
        "pii",
        "scam",
        "slurs",
        "prohibited_substance",
        "dating",
        "off_platform_contact"
      ]
    },
    {
      "id": "contains_english_majority",
      "type": "noul",
      "description": "true if message is majority English tokens (learning world may still allow EN; flag for analytics / soft nudge)"
    },
    {
      "id": "looks_like_real_name_or_phone",
      "type": "noul",
      "description": "true if message appears to contain a real personal name used as contact bait and/or phone-like digit runs"
    },
    {
      "id": "toxicity",
      "type": "score",
      "range": [
        0,
        1
      ],
      "description": "0 clean → 1 severe"
    },
    {
      "id": "action",
      "type": "choice",
      "choices": [
        "allow",
        "warn",
        "block",
        "escalate",
        "rewrite_not_used"
      ]
    }
  ],
  "action_policy": {
    "allow": "Normal chat, learning, slang allowlist",
    "warn": "Soft flag / UI toast; message may still show or be soft-held per client",
    "block": "Hard fail constitution / blocklist / PII",
    "escalate": "Ambiguous ethnic/context (e.g. bare preto); hide optional + queue",
    "rewrite_not_used": "CEO lock 2026-09-25: NEVER auto-rewrite player chat in Phase 0"
  },
